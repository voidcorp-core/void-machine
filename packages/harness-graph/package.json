{
  "name": "@voidcorp/harness-graph",
  "version": "5.0.4",
  "description": "void-machine graph kernel — derive the skill/agent/hook/pack/workflow graph, declared relations, and static analyses (the source of truth the studio renders).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./project": {
      "import": "./dist/project/index.js",
      "types": "./dist/project/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declarationMap false",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "picomatch": "^4.0.5",
    "yaml": "^2.5.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/picomatch": "^4.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@voidcorp/mission-engine": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript5": "npm:typescript@~5.9.3",
    "vitest": "^5.0.1"
  }
}
