{
  "name": "@voidcorp/pack-nextjs",
  "version": "5.0.4",
  "description": "Next.js 16 App Router conventions for Void Machine — route groups, Cache Components, instrumentation. Composes with @voidcorp/pack-react (UI) and @voidcorp/pack-server (Server Actions, webhooks).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./async": {
      "import": "./dist/async/index.js",
      "types": "./dist/async/index.d.ts"
    },
    "./claude/*": "./claude/*"
  },
  "files": [
    "dist",
    "claude",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declarationMap false",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@voidcorp/pack-monorepo": "workspace:^"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "voidcorp",
    "claude-code",
    "nextjs",
    "app-router",
    "harness"
  ]
}
