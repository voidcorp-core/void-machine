{
  "description": "Codex CLI hooks manifest — the Codex-side mirror of the Claude Code hooks wired in ../.claude-plugin/plugin.json. Both runtimes invoke the same portable Node rules; the runner normalizes Claude single-file Edit/Write and Codex multi-file apply_patch. `void-machine init` stages the runner and compiles each command into a Node bootstrap that finds it from the session directory, so the versioned manifest holds no machine path.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce dangerous-command codex"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write|Read|read_file|Grep|Bash|shell|shell_command|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce protected-file codex"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce secret-content codex"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" enforce control-character codex"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" activation codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" outcome codex"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" lifecycle context codex"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" lifecycle herdr-metadata codex"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" lifecycle herdr-metadata codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" stop codex"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${VOID_HOOKS_DIR}/_void-hook.mjs\" lifecycle herdr-metadata codex"
          }
        ]
      }
    ]
  }
}
