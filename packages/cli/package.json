{
  "name": "voidmachine",
  "version": "4.0.0",
  "description": "void-machine CLI — install an opinionated engineering doctrine on any project; render deterministic project health. Run via `npx voidmachine`; command: void-machine (alias vm).",
  "license": "MIT",
  "author": "Folpe @ VoidCorp",
  "homepage": "https://github.com/voidcorp-core/void-machine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidcorp-core/void-machine.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/voidcorp-core/void-machine/issues"
  },
  "keywords": [
    "cli",
    "claude-code",
    "codex",
    "ai-agent",
    "developer-tools",
    "code-quality",
    "tdd",
    "doctrine",
    "void-machine"
  ],
  "type": "module",
  "bin": {
    "voidmachine": "./bin/void-machine.mjs",
    "void-machine": "./bin/void-machine.mjs",
    "vm": "./bin/void-machine.mjs",
    "void-harness": "./bin/void-harness.mjs"
  },
  "files": [
    "bin",
    "dist",
    "core-assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:assets": "node scripts/copy-core-assets.mjs",
    "build:void-graph": "node --import tsx scripts/build-void-graph.ts",
    "build:certification": "node --import tsx scripts/build-certification.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm -w build:cli && pnpm run build:assets"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@clack/prompts": "^1.5.0",
    "@types/node": "^24.13.6",
    "@types/picomatch": "^4.0.3",
    "@voidcorp/harness-graph": "workspace:*",
    "@voidcorp/hook-runner": "workspace:*",
    "@voidcorp/mission-engine": "workspace:*",
    "@voidcorp/void-machine": "workspace:*",
    "esbuild": "^0.28.0",
    "picomatch": "^4.0.5",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "ws": "8.21.0",
    "yaml": "^2.5.0",
    "zod": "^4.6.5"
  }
}
