{
  "name": "@voidcorp/graph-studio",
  "version": "0.0.0",
  "private": true,
  "description": "void-machine graph studio — interactive 3D view of the skill/agent/hook/pack/workflow graph (renders harness-graph model.json). Repo-internal, not published.",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "prepare-data": "node --import tsx scripts/prepare-data.ts",
    "predev": "pnpm run prepare-data",
    "dev": "vite",
    "prebuild": "pnpm run prepare-data",
    "build": "vite build",
    "build:singlefile": "pnpm run prepare-data && VOID_SINGLEFILE=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "3d-force-graph": "^1.73.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "gsap": "^3.12.5",
    "three": "^0.185.0",
    "three-spritetext": "^1.9.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^24.13.6",
    "@types/three": "^0.185.0",
    "@voidcorp/harness-graph": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
