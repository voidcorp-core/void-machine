{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "packages/**/src/**/*.{ts,tsx,js,mjs,cjs}",
      "packages/**/test/**/*.{ts,tsx,js,mjs,cjs}",
      "packages/**/*.{test,spec}.{ts,tsx,js,mjs,cjs}",
      "packages/core/hooks/*.test.ts",
      "packages/**/*.config.ts",
      "apps/**/src/**/*.{ts,tsx,js,mjs,cjs}",
      "apps/**/scripts/**/*.ts",
      "apps/**/*.config.ts",
      "test/**/*.{ts,tsx,js,mjs,cjs}",
      "!**/node_modules",
      "!**/dist",
      "!**/templates",
      "!**/generated",
      "!**/*.d.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "formatter": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": [
        "packages/cli/src/commands/install.ts",
        "packages/cli/src/commands/graph.ts",
        "packages/cli/src/void-graph.ts",
        "apps/graph-studio/src/logger.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/harness-graph/src/project/test-fixtures/monorepo/packages/app/src/index.specimen.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/eval-harness/fixtures/ui/frontend-tdd/src/ActionMenu.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          }
        }
      }
    }
  ]
}
