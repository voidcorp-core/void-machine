{
  "name": "@voidcorp/hook-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Portable Node hook adapter and sequenced event writer for void-harness.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "benchmark": "node benchmarks/context-continuity.mjs",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=../core/hooks/_void-hook.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@voidcorp/mission-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
