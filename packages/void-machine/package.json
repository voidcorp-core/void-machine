{
  "name": "@voidcorp/void-machine",
  "version": "0.0.0",
  "private": true,
  "description": "Layered TypeScript implementation of retained Void Machine capabilities.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/application/doctor.js",
  "types": "./dist/application/doctor.d.ts",
  "exports": {
    ".": {
      "types": "./dist/application/doctor.d.ts",
      "import": "./dist/application/doctor.js"
    },
    "./agents": {
      "types": "./dist/application/agents.d.ts",
      "import": "./dist/application/agents.js"
    }
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.tests.json --noEmit && tsc --project tsconfig.pure.json",
    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "ws": "8.21.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/ws": "8.18.1",
    "@typescript/typescript6": "6.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
