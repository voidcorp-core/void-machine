{
  "name": "void-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Production-grade Claude Code harness for VoidCorp. Core craftsman skills + pluggable stack packs.",
  "license": "MIT",
  "author": "Florent Pellegrin <florent.pellegrin@voidcorp.io>",
  "homepage": "https://github.com/voidcorp-core/void-machine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidcorp-core/void-machine.git"
  },
  "bugs": {
    "url": "https://github.com/voidcorp-core/void-machine/issues"
  },
  "scripts": {
    "backlog:index": "node scripts/backlog-index.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || exit 0",
    "build": "pnpm -r --filter '!void-harness' build",
    "build:cli": "pnpm --filter @voidcorp/mission-engine build && pnpm --filter @voidcorp/harness-graph build && pnpm --filter @voidcorp/hook-runner build && pnpm --filter @voidcorp/void-machine build && pnpm --filter ./packages/cli build",
    "cli": "pnpm build:cli >/dev/null && node packages/cli/bin/void-machine.mjs",
    "benchmark:project": "pnpm --filter @voidcorp/harness-graph build && node packages/harness-graph/benchmarks/project-graph/run.mjs",
    "benchmark:query": "pnpm --filter @voidcorp/harness-graph build && node packages/harness-graph/benchmarks/project-graph-query/run.mjs",
    "benchmark:hooks": "pnpm hooks:build && pnpm --filter @voidcorp/hook-runner benchmark",
    "test": "pnpm test:cpu && pnpm test:filesystem && pnpm test:subprocess && pnpm test:network",
    "test:fast": "vitest run --project=pure:cpu --project=contract:cpu --maxWorkers=4",
    "test:component": "pnpm test:filesystem && pnpm test:subprocess",
    "test:cpu": "vitest run --project=*:cpu --maxWorkers=4",
    "test:filesystem": "vitest run --project=*:filesystem --maxWorkers=2",
    "test:subprocess": "vitest run --project=*:subprocess --maxWorkers=1",
    "test:pure": "vitest run --project=pure:* --maxWorkers=4",
    "test:contract": "vitest run --project=contract:* --maxWorkers=1",
    "test:consumer": "vitest run --project=consumer:* --maxWorkers=1",
    "test:system": "vitest run --project=system:* --maxWorkers=1",
    "test:certification": "vitest run --project=certification:* --maxWorkers=1",
    "test:network": "node scripts/test-network.mjs",
    "test:watch": "vitest",
    "lint": "biome lint --max-diagnostics=none",
    "typecheck": "pnpm -r --filter '!void-harness' typecheck",
    "anti-bloat:check": "bash scripts/anti-bloat-check.sh",
    "decisions:render": "pnpm build:cli && node scripts/build-decisions-index.mjs",
    "decisions:build": "pnpm decisions:render",
    "decisions:check": "pnpm build:cli && node scripts/build-decisions-index.mjs --check",
    "sync:docs": "bash scripts/sync-agent-docs.sh",
    "sync:philosophy": "bash scripts/sync-philosophy.sh",
    "version:check": "node scripts/check-version-lockstep.mjs",
    "check:publish": "node scripts/check-publish-safety.mjs",
    "check:size": "node scripts/check-package-size.mjs",
    "bump": "node scripts/bump-version.mjs",
    "release": "node scripts/check-publish-safety.mjs && pnpm --filter ./packages/cli publish",
    "certification:build": "pnpm --filter @voidcorp/harness-graph build && pnpm --filter ./packages/cli build:certification",
    "certification:check": "pnpm --filter @voidcorp/harness-graph build && pnpm --filter ./packages/cli build:certification -- --check",
    "graph:check": "pnpm --filter @voidcorp/harness-graph build && node packages/cli/bin/void-machine.mjs graph check",
    "graph:check-bundle": "node packages/cli/bin/void-machine.mjs graph check-bundle",
    "hooks:build": "pnpm --filter @voidcorp/mission-engine build && pnpm --filter @voidcorp/hook-runner build",
    "conformance:pack": "node packages/cli/scripts/conformance-artifact.mjs",
    "conformance:consumer": "node packages/cli/scripts/conformance-consumer.mjs",
    "conformance:install": "node packages/cli/scripts/conformance-consumer.mjs --suite install",
    "conformance:hooks": "node packages/cli/scripts/conformance-consumer.mjs --suite hooks",
    "conformance:autopilot": "node packages/cli/scripts/conformance-consumer.mjs --suite autopilot",
    "conformance:project-graph": "node scripts/conformance-project-graph.mjs",
    "eval": "pnpm build:cli && pnpm --filter @voidcorp/eval-harness run eval --",
    "verify": "node scripts/verify.mjs",
    "ci:gates:render": "node scripts/render-ci-gates.mjs",
    "ci:gates:check": "node scripts/render-ci-gates.mjs --check",
    "cheatsheet:build": "node scripts/build-cheatsheet.mjs",
    "cheatsheet:check": "node scripts/build-cheatsheet.mjs --check",
    "derive": "node scripts/derive.mjs",
    "derive:check": "node scripts/derive.mjs --check",
    "skills:check-references": "node scripts/check-skill-references.mjs",
    "skills:register": "node scripts/build-skill-references.mjs",
    "skills:register-check": "node scripts/build-skill-references.mjs --check",
    "skills:check-paths": "node scripts/check-asset-paths.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.13.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.18"
    }
  },
  "keywords": [
    "claude-code",
    "anthropic",
    "harness",
    "skills",
    "agents",
    "tdd",
    "tigerstyle",
    "craftsman",
    "voidcorp"
  ]
}
