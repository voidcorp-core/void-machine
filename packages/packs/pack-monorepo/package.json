{
  "name": "@voidcorp/pack-monorepo",
  "version": "5.0.5",
  "description": "Turborepo monorepo conventions for Void Machine — shared tsconfig.strict, @repo/core helpers (Result, Option, pipe), package boundary discipline.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./result": {
      "import": "./dist/result.js",
      "types": "./dist/result.d.ts"
    },
    "./option": {
      "import": "./dist/option.js",
      "types": "./dist/option.d.ts"
    },
    "./pipe": {
      "import": "./dist/pipe.js",
      "types": "./dist/pipe.d.ts"
    },
    "./tsconfig.strict.json": "./tsconfig.strict.json",
    "./claude/*": "./claude/*"
  },
  "files": [
    "dist",
    "claude",
    "tsconfig.strict.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declarationMap false",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "typescript-5.0": "npm:typescript@5.0.4",
    "typescript-5.9": "npm:typescript@5.9.3",
    "typescript-6.0": "npm:typescript@6.0.3",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "voidcorp",
    "claude-code",
    "monorepo",
    "turborepo",
    "bun",
    "harness"
  ]
}
